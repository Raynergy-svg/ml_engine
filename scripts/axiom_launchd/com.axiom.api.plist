<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>AXIOM_CONTROL_ENABLED</key>
		<string>1</string>
		<key>PATH</key>
		<string>/opt/homebrew/Caskroom/miniforge/base/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.axiom.api</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/Caskroom/miniforge/base/bin/python3</string>
		<string>-m</string>
		<string>uvicorn</string>
		<string>dashboard.server.app:app</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8888</string>
		<string>--no-access-log</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/buddy/Library/Logs/com.axiom.api.log</string>
	<key>StandardOutPath</key>
	<string>/Users/buddy/Library/Logs/com.axiom.api.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>/Users/buddy/Documents/ml_engine</string>
</dict>
</plist>
