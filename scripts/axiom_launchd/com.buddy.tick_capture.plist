<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.buddy.tick_capture</string>
  <!-- PRACTICE-ONLY pricing stream. No order endpoint exists in this process. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/Caskroom/miniforge/base/bin/python3</string>
    <string>scripts/run_tick_capture.py</string>
    <string>--pairs</string>
    <string>ALL_FX</string>
    <string>--flush-interval</string>
    <string>30</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/buddy/Documents/ml_engine</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/Caskroom/miniforge/base/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <!-- Shutdown drains the tick buffer to Parquet under _persist_lock, which can
       outlast launchd's 5s default and get the process SIGKILLed mid-flush
       (observed 2026-07-14: SIGTERM at 18:49:14, no final flush, killed -9). -->
  <key>ExitTimeOut</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/buddy/Documents/ml_engine/trained_data/axiom/tick_capture.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/buddy/Documents/ml_engine/trained_data/axiom/tick_capture.out</string>
</dict>
</plist>
