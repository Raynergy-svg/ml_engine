<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.buddy.trend</string>
  <!-- The OANDA daily-trend trading loop (PRACTICE only). Respects state.json halt
       EVERY cycle: a KeepAlive respawn restores the operator's LAST state and REFUSES
       to trade while halted. KeepAlive = process resilience, NOT a halt bypass. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/Caskroom/miniforge/base/bin/python3</string>
    <string>scripts/run_oanda_trend.py</string>
    <string>--loop</string>
    <string>3600</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/buddy/Documents/ml_engine</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/Caskroom/miniforge/base/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/buddy/Library/Logs/com.buddy.trend.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/buddy/Library/Logs/com.buddy.trend.log</string>
</dict>
</plist>
