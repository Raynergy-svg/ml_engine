<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.buddy.forward_daily</string>
  <!-- Analysis-only Track B, hedge, and readiness capture; no order path. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/Caskroom/miniforge/base/bin/python3</string>
    <string>scripts/run_forward_capture_daily.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/buddy/Documents/ml_engine</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/Caskroom/miniforge/base/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>23</integer>
    <key>Minute</key><integer>10</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/buddy/Library/Logs/com.buddy.forward_daily.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/buddy/Library/Logs/com.buddy.forward_daily.log</string>
</dict>
</plist>
