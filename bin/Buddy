#!/usr/bin/env bash
set -euo pipefail
VERSION="2.3.0"
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ROOT_DIR="$(cd -P "${SCRIPT_DIR}/.." && pwd)"

# Auto-detect architecture: Intel (x86_64) vs Apple Silicon (arm64)
if [[ "$(uname -m)" == "x86_64" ]]; then
    # Intel Mac: Use CPU-optimized config and intel conda env
    CONFIG_FILE="${ROOT_DIR}/config/config_intel_optimized.yaml"
    ENV_NAME="${BUDDY_CONDA_ENV:-intel}"
    INTEL_MAC_FLAGS="--no-mixed-precision"
else
    # Apple Silicon (M1/M2/M3): Use Metal-optimized config and tf-metal conda env
    CONFIG_FILE="${ROOT_DIR}/config/config_improved_H1.yaml"
    ENV_NAME="${BUDDY_CONDA_ENV:-tf-metal}"
    INTEL_MAC_FLAGS=""
fi

get_conda() {
    for p in "${HOME}/miniforge3/bin/conda" "${HOME}/miniconda3/bin/conda"; do
        [[ -x "$p" ]] && { echo "$p"; return; }
    done
    command -v conda 2>/dev/null || { echo "conda not found" >&2; exit 1; }
}

run_py() { "$(get_conda)" run -n "${ENV_NAME}" --no-capture-output python "$@"; }

cmd_predict() {
    local granularity="H1"
    local instrument=""
    local args=()
    
    # First positional arg is instrument if not a flag
    if [[ $# -gt 0 && ! "$1" =~ ^- ]]; then
        instrument="$1"
        shift
    fi
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -i|--instrument) instrument="$2"; shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            -x|--execute) args+=(--execute); shift ;;
            --no-execute) args+=(--no-execute); shift ;;
            -v|--verbose) args+=(--verbose); shift ;;
            --use-rl-sizer) args+=(--use-rl-sizer); shift ;;
            --explain) args+=(--explain); shift ;;
            --intelligent) args+=(--intelligent); shift ;;
            --no-intelligent) args+=(--no-intelligent); shift ;;
            --llm-provider) args+=(--llm-provider "$2"); shift 2 ;;
            --llm-enhance) args+=(--llm-enhance); shift ;;
            --dry-run) args+=(--dry-run); shift ;;
            *) args+=("$1"); shift ;;  # Pass through unknown args
        esac
    done
    run_py "${ROOT_DIR}/main.py" buddy --config "${CONFIG_FILE}" --granularity "${granularity}" "${args[@]+"${args[@]}"}"
}

cmd_train() {
    local granularity="H1"  # Default to H1 to match config
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--candles) args+=(--candles "$2"); shift 2 ;;
            -i|-I|--instrument) args+=(--instrument "$2"); shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            -m|--model) args+=(--model-type "$2"); shift 2 ;;
            --oanda-live) args+=(--oanda-live); shift ;;
            --multi-pair) args+=(--multi-pair); shift ;;
            --foundation-pairs) args+=(--foundation-pairs "$2"); shift 2 ;;
            --no-warm-start) args+=(--no-warm-start); shift ;;
            --fine-tune|--warm-start) args+=(--warm-start); shift ;;  # Fine-tune = warm-start from existing model
            --init-from) args+=(--init-from "$2"); shift 2 ;;  # Initialize from specific checkpoint
            -v|--verbose) args+=(--verbose); shift ;;
            --enterprise) args+=(--enterprise); shift ;;
            --cv-folds) args+=(--cv-folds "$2"); shift 2 ;;
            --bootstrap) args+=(--bootstrap); shift ;;
            # Intel Mac optimization flags
            --batch-size) args+=(--batch-size "$2"); shift 2 ;;
            --workers) args+=(--workers "$2"); shift 2 ;;
            --no-mixed-precision) args+=(--no-mixed-precision); shift ;;
            --mixed-precision) INTEL_MAC_FLAGS=""; shift ;;  # Override Intel default
            # TCN Volatility Regime training (4-class: LOW/NORMAL/HIGH/EXTREME)
            --train-volatility-regime|--train-vol-regime) args+=(--train-volatility-regime); shift ;;
            --no-volatility-regime) args+=(--no-volatility-regime); shift ;;
            *) args+=("$1"); shift ;;  # Pass through unknown args instead of discarding
        esac
    done
    # Append Intel Mac flags if set (--no-mixed-precision for x86_64)
    [[ -n "${INTEL_MAC_FLAGS:-}" ]] && args+=(${INTEL_MAC_FLAGS})
    run_py "${ROOT_DIR}/main.py" train-buddy --config "${CONFIG_FILE}" --granularity "${granularity}" "${args[@]+"${args[@]}"}"
}

cmd_scan() {
    local granularity="H1"  # Default to H1 to match config_improved_H1.yaml
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pairs) args+=(--pairs "$2"); shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            --top) args+=(--top "$2"); shift 2 ;;
            -v|--verbose) args+=(--verbose); shift ;;
            -d|--diversified) args+=(--diversified); shift ;;
            --force) args+=(--force); shift ;;
            --use-rl-sizer) args+=(--use-rl-sizer); shift ;;
            --no-rl-sizer) args+=(--no-use-rl-sizer); shift ;;
            *) args+=("$1"); shift ;;
        esac
    done
    run_py "${ROOT_DIR}/main.py" scan --config "${CONFIG_FILE}" --granularity "${granularity}" "${args[@]+"${args[@]}"}"
}

cmd_analyze() {
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --top) args+=(--top "$2"); shift 2 ;;
            --save) args+=(--save); shift ;;
            -v|--verbose) args+=(--verbose); shift ;;
            *) shift ;;
        esac
    done
    run_py "${ROOT_DIR}/main.py" analyze --config "${CONFIG_FILE}" "${args[@]+"${args[@]}"}"
}

cmd_journal() {
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -u|--update) args+=(--update); shift ;;
            -d|--days) args+=(--days "$2"); shift 2 ;;
            -v|--verbose) args+=(--verbose); shift ;;
            -i|--import) args+=(--import-trades); shift ;;
            *) shift ;;
        esac
    done
    run_py "${ROOT_DIR}/main.py" journal --config "${CONFIG_FILE}" "${args[@]+"${args[@]}"}"
}

cmd_test() {
    local granularity="H1"  # Default to H1 to match config_improved_H1.yaml
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--candles) args+=(--candles "$2"); shift 2 ;;
            -i|-I|--instrument) args+=(--instrument "$2"); shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            --dry-run) args+=(--dry-run); shift ;;
            *) shift ;;
        esac
    done
    run_py "${ROOT_DIR}/main.py" test --config "${CONFIG_FILE}" --granularity "${granularity}" "${args[@]+"${args[@]}"}"
}

cmd_find() {
    local granularity="H1"
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -i|-I|--instrument) args+=(--instrument "$2"); shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            -c|--candles|--max-candles) args+=(--max-candles "$2"); shift 2 ;;
            --min|--min-candles) args+=(--min-candles "$2"); shift 2 ;;
            --step) args+=(--step "$2"); shift 2 ;;
            --cv-folds) args+=(--cv-folds "$2"); shift 2 ;;
            --no-auto-train) args+=(--no-auto-train); shift ;;
            -v|--verbose) args+=(--verbose); shift ;;
            *) args+=("$1"); shift ;;
        esac
    done
    run_py "${ROOT_DIR}/main.py" find-candles --config "${CONFIG_FILE}" --granularity "${granularity}" "${args[@]+"${args[@]}"}"
}

cmd_status() { run_py "${ROOT_DIR}/main.py" model-status --config "${CONFIG_FILE}"; }
cmd_promote() { run_py "${ROOT_DIR}/main.py" promote-model --config "${CONFIG_FILE}"; }
cmd_loop() { run_py "${ROOT_DIR}/main.py" buddy --config "${CONFIG_FILE}" --loop --candles 2000; }

main() {
    [[ $# -eq 0 ]] && { cmd_predict; exit $?; }
    local cmd="$1"; shift
    case "${cmd}" in
        predict|p) cmd_predict "$@" ;;
        train|t) cmd_train "$@" ;;
        scan) cmd_scan "$@" ;;
        analyze|a) cmd_analyze "$@" ;;
        test) cmd_test "$@" ;;
        journal|j) cmd_journal "$@" ;;
        find|f) cmd_find "$@" ;;
        status|s) cmd_status ;;
        promote) cmd_promote ;;
        loop|l) cmd_loop ;;
        help|-h|--help) echo "buddy <predict|train|scan|find|analyze|test|journal|status|loop>" ;;
        *) cmd_predict "${cmd}" "$@" ;;
    esac
}

main "$@"
