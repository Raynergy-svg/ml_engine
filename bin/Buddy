#!/usr/bin/env bash
set -euo pipefail
VERSION="2.2.0"
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
ROOT_DIR="$(cd -P "${SCRIPT_DIR}/.." && pwd)"

# Auto-detect conda environment AND config based on architecture
if [[ -n "${BUDDY_CONDA_ENV:-}" ]]; then
    ENV_NAME="${BUDDY_CONDA_ENV}"
elif [[ "$(uname -m)" == "x86_64" ]]; then
    ENV_NAME="intel"  # Intel Mac
else
    ENV_NAME="tf-metal"  # Apple Silicon (M1/M2/M3)
fi

# Auto-select config: Intel uses intel-optimized, Apple Silicon uses H1
if [[ -n "${BUDDY_CONFIG:-}" ]]; then
    CONFIG_FILE="${BUDDY_CONFIG}"
elif [[ "$(uname -m)" == "x86_64" ]]; then
    CONFIG_FILE="${ROOT_DIR}/config/config_intel_optimized.yaml"
else
    CONFIG_FILE="${ROOT_DIR}/config/config_improved_H1.yaml"
fi

# Ensure plotting/font caches are writable in restricted environments (CI/sandbox).
CACHE_ROOT="${BUDDY_CACHE_DIR:-${ROOT_DIR}/.buddy_cache}"
export MPLCONFIGDIR="${MPLCONFIGDIR:-${CACHE_ROOT}/matplotlib}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${CACHE_ROOT}/xdg}"
mkdir -p "${MPLCONFIGDIR}" "${XDG_CACHE_HOME}/fontconfig" >/dev/null 2>&1 || true

declare -a PYTHON_LAUNCHER=()

init_python_launcher() {
    # Prefer an explicitly configured interpreter (useful for custom conda layouts).
    if [[ -n "${BUDDY_PYTHON:-}" && -x "${BUDDY_PYTHON}" ]]; then
        PYTHON_LAUNCHER=("${BUDDY_PYTHON}")
        return
    fi

    # Prefer the active conda interpreter when available.
    if [[ -n "${CONDA_PREFIX:-}" ]]; then
        local active_python="${CONDA_PREFIX}/bin/python"
        if [[ -x "${active_python}" ]]; then
            PYTHON_LAUNCHER=("${active_python}")
            return
        fi
    fi

    # If the target environment exists on disk but `conda run` has issues, use it directly.
    local named_env_python=""
    if [[ -x "${HOME}/miniforge3/envs/${ENV_NAME}/bin/python" ]]; then
        named_env_python="${HOME}/miniforge3/envs/${ENV_NAME}/bin/python"
    elif [[ -x "${HOME}/miniconda3/envs/${ENV_NAME}/bin/python" ]]; then
        named_env_python="${HOME}/miniconda3/envs/${ENV_NAME}/bin/python"
    fi
    if [[ -n "${named_env_python}" ]]; then
        PYTHON_LAUNCHER=("${named_env_python}")
        return
    fi

    PYTHON_LAUNCHER=(
        "$(get_conda)"
        run
        -n
        "${ENV_NAME}"
        --no-capture-output
        python
    )
}

get_conda() {
    for p in "${HOME}/miniforge3/bin/conda" "${HOME}/miniconda3/bin/conda"; do
        [[ -x "$p" ]] && { echo "$p"; return; }
    done
    command -v conda 2>/dev/null || { echo "conda not found" >&2; exit 1; }
}

init_python_launcher
run_py() { "${PYTHON_LAUNCHER[@]}" "$@"; }

cmd_predict() {
    local granularity="H1"
    local instrument=""
    local args=()
    
    # First positional arg is instrument if not a flag
    if [[ $# -gt 0 && ! "$1" =~ ^- ]]; then
        instrument="$1"
        shift
    fi
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -i|--instrument) instrument="$2"; shift 2 ;;
            -c|--candles) args+=(--candles "$2"); shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            -x|--execute) args+=(--execute); shift ;;
            --no-execute) args+=(--no-execute); shift ;;
            -v|--verbose) args+=(--verbose); shift ;;
            --use-rl-sizer) args+=(--use-rl-sizer); shift ;;
            --explain) args+=(--explain); shift ;;
            --intelligent) args+=(--intelligent); shift ;;
            --no-intelligent) args+=(--no-intelligent); shift ;;
            --llm-provider) args+=(--llm-provider "$2"); shift 2 ;;
            --llm-enhance) args+=(--llm-enhance); shift ;;
            --profile) args+=(--profile "$2"); shift 2 ;;
            --dry-run) args+=(--dry-run); shift ;;
            *) args+=("$1"); shift ;;  # Pass through unknown args
        esac
    done
    # Build instrument arg if provided
    local inst_args=()
    if [[ -n "${instrument}" ]]; then
        inst_args=(--instrument "${instrument}")
    fi
    run_py "${ROOT_DIR}/main.py" buddy --config "${CONFIG_FILE}" --granularity "${granularity}" "${inst_args[@]+"${inst_args[@]}"}" "${args[@]+"${args[@]}"}"
}

cmd_chat() {
    local granularity="M5"
    local instrument=""
    local args=()

    # Default Buddy chat to planner mode unless the user explicitly overrides it.
    export BUDDY_CHAT_MODE="${BUDDY_CHAT_MODE:-planner}"

    if [[ $# -gt 0 && ! "$1" =~ ^- ]]; then
        instrument="$1"
        shift
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -i|--instrument) instrument="$2"; shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            -c|--candles) args+=(--candles "$2"); shift 2 ;;
            -x|--execute) args+=(--execute); shift ;;
            --no-execute) args+=(--no-execute); shift ;;
            --dry-run) args+=(--dry-run); shift ;;
            -v|--verbose) args+=(--verbose); shift ;;
            --model-path) args+=(--model-path "$2"); shift 2 ;;
            --all-features) args+=(--all-features); shift ;;
            --no-all-features) args+=(--no-all-features); shift ;;
            *) args+=("$1"); shift ;;
        esac
    done

    local inst_args=()
    if [[ -n "${instrument}" ]]; then
        inst_args=(--instrument "${instrument}")
    fi
    run_py "${ROOT_DIR}/main.py" buddy-chat --config "${CONFIG_FILE}" --granularity "${granularity}" "${inst_args[@]+"${inst_args[@]}"}" "${args[@]+"${args[@]}"}"
}

cmd_train() {
    local granularity="H1"  # Default to H1 to match config_improved_H1.yaml
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--candles) args+=(--candles "$2"); shift 2 ;;
            -i|-I|--instrument) args+=(--instrument "$2"); shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            -m|--model) args+=(--model-type "$2"); shift 2 ;;
            --oanda-live) args+=(--oanda-live); shift ;;
            --multi-pair) args+=(--multi-pair); shift ;;
            --foundation-pairs) args+=(--foundation-pairs "$2"); shift 2 ;;
            --no-warm-start) args+=(--no-warm-start); shift ;;
            *) args+=("$1"); shift ;;  # Pass through unknown args instead of discarding
        esac
    done
    run_py "${ROOT_DIR}/main.py" train-buddy --config "${CONFIG_FILE}" --granularity "${granularity}" "${args[@]+"${args[@]}"}"
}

cmd_scan() {
    local granularity="H1"  # Default to H1 to match config_improved_H1.yaml
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pairs) args+=(--pairs "$2"); shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            --top) args+=(--top "$2"); shift 2 ;;
            -v|--verbose) args+=(--verbose); shift ;;
            --watch) args+=(--watch); shift ;;
            --interval) args+=(--interval "$2"); shift 2 ;;
            --auto-execute) args+=(--auto-execute); shift ;;
            --no-train) args+=(--no-train); shift ;;
            --skip-execute) args+=(--skip-execute); shift ;;
            -d|--diversified) args+=(--diversified); shift ;;
            --force) args+=(--force); shift ;;
            --profile) args+=(--profile "$2"); shift 2 ;;
            --use-rl-sizer) args+=(--use-rl-sizer); shift ;;
            --no-use-rl-sizer) args+=(--no-use-rl-sizer); shift ;;
            --enforce-policy) args+=(--enforce-policy "$2"); shift 2 ;;
            *) args+=("$1"); shift ;;  # Pass through unknown args instead of dropping them
        esac
    done
    run_py "${ROOT_DIR}/main.py" scan --config "${CONFIG_FILE}" --granularity "${granularity}" "${args[@]+"${args[@]}"}"
}

cmd_analyze() {
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --top) args+=(--top "$2"); shift 2 ;;
            --save) args+=(--save); shift ;;
            -v|--verbose) args+=(--verbose); shift ;;
            *) shift ;;
        esac
    done
    run_py "${ROOT_DIR}/main.py" analyze --config "${CONFIG_FILE}" "${args[@]+"${args[@]}"}"
}

cmd_journal() {
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -u|--update) args+=(--update); shift ;;
            -d|--days) args+=(--days "$2"); shift 2 ;;
            -v|--verbose) args+=(--verbose); shift ;;
            -i|--import) args+=(--import-trades); shift ;;
            *) shift ;;
        esac
    done
    run_py "${ROOT_DIR}/main.py" journal --config "${CONFIG_FILE}" "${args[@]+"${args[@]}"}"
}

cmd_test() {
    local granularity="H1"  # Default to H1 to match config_improved_H1.yaml
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--candles) args+=(--candles "$2"); shift 2 ;;
            -i|-I|--instrument) args+=(--instrument "$2"); shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            --dry-run) args+=(--dry-run); shift ;;
            *) shift ;;
        esac
    done
    run_py "${ROOT_DIR}/main.py" test --config "${CONFIG_FILE}" --granularity "${granularity}" "${args[@]+"${args[@]}"}"
}

cmd_monitor() {
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --alerts) args+=(--monitor-alerts); shift ;;
            --drift) args+=(--monitor-drift); shift ;;
            --report) args+=(--monitor-report); shift ;;
            --limit) args+=(--monitor-limit "$2"); shift 2 ;;
            --training) args+=(--training); shift ;;
            --model) args+=(--model "$2"); shift 2 ;;
            --replay) args+=(--replay "$2"); shift 2 ;;
            *) shift ;;
        esac
    done
    run_py "${ROOT_DIR}/main.py" monitor --config "${CONFIG_FILE}" "${args[@]+"${args[@]}"}"
}

cmd_status() {
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --decisions) args+=(--decisions); shift ;;
            *) args+=("$1"); shift ;;
        esac
    done
    run_py "${ROOT_DIR}/main.py" status --config "${CONFIG_FILE}" "${args[@]+"${args[@]}"}"
}
cmd_promote() { run_py "${ROOT_DIR}/main.py" promote-model --config "${CONFIG_FILE}"; }
cmd_loop() { run_py "${ROOT_DIR}/main.py" buddy --config "${CONFIG_FILE}" --loop --candles 2000; }

cmd_train_joint() {
    local granularity="H1"
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --instruments) args+=(--instruments "$2"); shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            --fine-tune) args+=(--fine-tune); shift ;;
            --no-fine-tune) args+=(--no-fine-tune); shift ;;
            --fine-tune-threshold) args+=(--fine-tune-threshold "$2"); shift 2 ;;
            -v|--verbose) args+=(--verbose); shift ;;
            *) shift ;;
        esac
    done
    run_py "${ROOT_DIR}/main.py" train-joint --config "${CONFIG_FILE}" --granularity "${granularity}" "${args[@]+"${args[@]}"}"
}

cmd_retrain_all() {
    local granularity="H1"
    local candles="25000"
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--candles) candles="$2"; shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            -v|--verbose) args+=(--verbose); shift ;;
            *) shift ;;
        esac
    done
    run_py "${ROOT_DIR}/main.py" retrain-all --config "${CONFIG_FILE}" --granularity "${granularity}" --candles "${candles}" "${args[@]+"${args[@]}"}"
}

main() {
    [[ $# -eq 0 ]] && { cmd_predict; exit $?; }
    local cmd="$1"; shift
    case "${cmd}" in
        predict|p) cmd_predict "$@" ;;
        chat|c|buddy-chat) cmd_chat "$@" ;;
        train|t) cmd_train "$@" ;;
        train-joint|tj) cmd_train_joint "$@" ;;
        retrain-all|ra) cmd_retrain_all "$@" ;;
        scan) cmd_scan "$@" ;;
        analyze|a) cmd_analyze "$@" ;;
        test) cmd_test "$@" ;;
        journal|j) cmd_journal "$@" ;;
        find|f) cmd_find "$@" ;;
        status|s) cmd_status "$@" ;;
        promote) cmd_promote ;;
        loop|l) cmd_loop ;;
        monitor|m) cmd_monitor "$@" ;;
        help|-h|--help) cat << 'EOF'
Buddy v2.2.0 - FX Trading Assistant

COMMANDS:
  predict [PAIR] [-x]     Run prediction (default), -x to execute trade
  chat [PAIR]             Start Buddy conversational chat REPL
  train -i PAIR           Train models for instrument
  train-joint             Train all scanner pairs jointly (default: 15 pairs)
  retrain-all             Retrain all pairs
  scan [--pairs ...]      Scan pairs for opportunities
  analyze                 Analyze recent trades
  test                    Run test prediction
  journal [-u] [-d N]     View/update trade journal
  monitor                 Show monitoring dashboard and alerts
  status [--decisions]    Show runtime/account status
  loop                    Run continuous prediction loop

OPTIONS:
  --use-rl-sizer          Use RL-based position sizing (auto-enabled if model exists)
  --intelligent           Enable intelligent mode with LLM analysis
  --llm-enhance           Add LLM market commentary
  -x, --execute           Execute trades (live)
  -v, --verbose           Verbose output
  -g, --granularity G     Timeframe (default: H1)
  --profile P             Inference/scan profile: conservative|balanced|aggressive
  --dry-run               Preview without execution

MONITOR OPTIONS:
  --alerts                Show detailed alerts
  --drift                 Show model drift history
  --report                Generate full monitoring report
  --limit N               Limit drift history entries (default: 20)
  --training              Show training visualization mode
  --model TYPE            Show model architecture (TCN, TRANSFORMER)
  --replay FILE           Replay saved training history

SCAN OPTIONS:
  --watch                 Continuous scan mode (repeat every N minutes)
  --interval N            Scan interval in minutes (default: 5)
  --auto-execute          Auto-execute passing trades
  --enforce-policy LEVEL  Policy enforcement: 0=log-only 1=safe 2=+config 3=full

EXAMPLES:
  ./bin/Buddy EUR_USD              # Predict EUR/USD
  ./bin/Buddy chat EUR_USD         # Start Buddy chat on EUR/USD
  ./bin/Buddy status --decisions   # Show runtime status and persisted decisions
  ./bin/Buddy EUR_USD -x           # Predict and execute
  ./bin/Buddy train -i EUR_USD     # Train model for EUR/USD
  ./bin/Buddy train-joint          # Train all 15 scanner pairs
  ./bin/Buddy tj --instruments EUR_USD,GBP_USD  # Train specific pairs
  ./bin/Buddy scan --top 5         # Scan and show top 5 opportunities
  ./bin/Buddy scan --watch --auto-execute             # Watch mode with auto-trade
  ./bin/Buddy scan --watch --auto-execute --enforce-policy 1  # + safe enforcement
  ./bin/Buddy scan --profile aggressive --force
  ./bin/Buddy monitor              # Show monitoring dashboard
  ./bin/Buddy monitor --alerts     # Show detailed alerts
EOF
;;
        *) cmd_predict "${cmd}" "$@" ;;
    esac
}

main "$@"
