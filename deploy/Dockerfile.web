# AXIOM Next.js operator cockpit — REAL production server (next build && next start),
# the ONLY publicly exposed service. Build context = repo root:
#   docker build -f deploy/Dockerfile.web -t axiom-web .
FROM node:22-slim AS builder
WORKDIR /app/web
# Install deps against the committed lockfile (reproducible).
COPY dashboard/web/package.json dashboard/web/package-lock.json ./
RUN npm ci
# App source, then a production build.
COPY dashboard/web/ ./
RUN npm run build

FROM node:22-slim AS runner
WORKDIR /app/web
ENV NODE_ENV=production \
    PORT=8080 \
    NEXT_TELEMETRY_DISABLED=1
# AXIOM_API_ORIGIN (where to reach FastAPI), AXIOM_AUTH_SECRET, AXIOM_PASSWORD are
# injected at RUNTIME (host secrets/env) — never baked in. They are server-only.
COPY --from=builder /app/web/node_modules ./node_modules
COPY --from=builder /app/web/.next ./.next
COPY --from=builder /app/web/public ./public
COPY --from=builder /app/web/package.json ./package.json
COPY --from=builder /app/web/next.config.ts ./next.config.ts

EXPOSE 8080
# `next start` honors PORT; binds 0.0.0.0 so the platform can route to it.
CMD ["npm", "run", "start"]
