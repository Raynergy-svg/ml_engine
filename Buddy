#!/usr/bin/env bash
set -euo pipefail
VERSION="2.2.0"
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/config_improved_H1.yaml"

# Auto-detect environment: Intel Mac uses ml_engine_py312, M1 uses tf-metal
if [[ "$(uname -m)" == "x86_64" ]]; then
    ENV_NAME="${BUDDY_CONDA_ENV:-ml_engine_py312}"
else
    ENV_NAME="${BUDDY_CONDA_ENV:-tf-metal}"
fi

get_conda() {
    for p in "${HOME}/miniforge3/bin/conda" "${HOME}/miniconda3/bin/conda"; do
        [[ -x "$p" ]] && { echo "$p"; return; }
    done
    command -v conda 2>/dev/null || { echo "conda not found" >&2; exit 1; }
}

run_py() { "$(get_conda)" run -n "${ENV_NAME}" --no-capture-output python "$@"; }

cmd_predict() {
    local granularity="H1"
    local instrument=""
    local args=()
    
    # First positional arg is instrument if not a flag
    if [[ $# -gt 0 && ! "$1" =~ ^- ]]; then
        instrument="$1"
        shift
    fi
    
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -i|--instrument) instrument="$2"; shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            -x|--execute) args+=(--execute); shift ;;
            --no-execute) args+=(--no-execute); shift ;;
            -v|--verbose) args+=(--verbose); shift ;;
            --use-rl-sizer) args+=(--use-rl-sizer); shift ;;
            --explain) args+=(--explain); shift ;;
            --intelligent) args+=(--intelligent); shift ;;
            --no-intelligent) args+=(--no-intelligent); shift ;;
            --llm-provider) args+=(--llm-provider "$2"); shift 2 ;;
            --llm-enhance) args+=(--llm-enhance); shift ;;
            --dry-run) args+=(--dry-run); shift ;;
            *) args+=("$1"); shift ;;  # Pass through unknown args
        esac
    done
    
    # Default to EUR_USD if no instrument
    instrument="${instrument:-EUR_USD}"
    
    # Use main.py buddy which loads pair-specific models
    run_py "${SCRIPT_DIR}/main.py" buddy --config "${CONFIG_FILE}" \
        --instrument "${instrument}" \
        --granularity "${granularity}" \
        "${args[@]+"${args[@]}"}"
}

cmd_train() {
    local granularity="H1"  # Default to H1 to match config_improved_H1.yaml
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--candles) args+=(--candles "$2"); shift 2 ;;
            -i|-I|--instrument) args+=(--instrument "$2"); shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            -m|--model) args+=(--model-type "$2"); shift 2 ;;
            --oanda-live) args+=(--oanda-live); shift ;;
            --multi-pair) args+=(--multi-pair); shift ;;
            --foundation-pairs) args+=(--foundation-pairs "$2"); shift 2 ;;
            --no-warm-start) args+=(--no-warm-start); shift ;;
            *) args+=("$1"); shift ;;  # Pass through unknown args instead of discarding
        esac
    done
    run_py "${SCRIPT_DIR}/main.py" train-buddy --config "${CONFIG_FILE}" --granularity "${granularity}" "${args[@]+"${args[@]}"}"
}

cmd_scan() {
    local granularity="H1"  # Default to H1 to match config_improved_H1.yaml
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --pairs) args+=(--pairs "$2"); shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            --top) args+=(--top "$2"); shift 2 ;;
            -v|--verbose) args+=(--verbose); shift ;;
            -d|--diversified) args+=(--diversified); shift ;;
            *) shift ;;
        esac
    done
    run_py "${SCRIPT_DIR}/main.py" scan --config "${CONFIG_FILE}" --granularity "${granularity}" "${args[@]+"${args[@]}"}"
}

cmd_analyze() {
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --top) args+=(--top "$2"); shift 2 ;;
            --save) args+=(--save); shift ;;
            -v|--verbose) args+=(--verbose); shift ;;
            *) shift ;;
        esac
    done
    run_py "${SCRIPT_DIR}/main.py" analyze --config "${CONFIG_FILE}" "${args[@]+"${args[@]}"}"
}

cmd_journal() {
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -u|--update) args+=(--update); shift ;;
            -d|--days) args+=(--days "$2"); shift 2 ;;
            -v|--verbose) args+=(--verbose); shift ;;
            -i|--import) args+=(--import-trades); shift ;;
            *) shift ;;
        esac
    done
    run_py "${SCRIPT_DIR}/main.py" journal --config "${CONFIG_FILE}" "${args[@]+"${args[@]}"}"
}

cmd_test() {
    local granularity="H1"  # Default to H1 to match config_improved_H1.yaml
    local args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -c|--candles) args+=(--candles "$2"); shift 2 ;;
            -i|-I|--instrument) args+=(--instrument "$2"); shift 2 ;;
            -g|--granularity) granularity="$2"; shift 2 ;;
            --dry-run) args+=(--dry-run); shift ;;
            *) shift ;;
        esac
    done
    run_py "${SCRIPT_DIR}/main.py" test --config "${CONFIG_FILE}" --granularity "${granularity}" "${args[@]+"${args[@]}"}"
}

cmd_status() { run_py "${SCRIPT_DIR}/main.py" model-status --config "${CONFIG_FILE}"; }
cmd_promote() { run_py "${SCRIPT_DIR}/main.py" promote-model --config "${CONFIG_FILE}"; }
cmd_loop() { run_py "${SCRIPT_DIR}/main.py" buddy --config "${CONFIG_FILE}" --loop --candles 2000; }

main() {
    [[ $# -eq 0 ]] && { cmd_predict; exit $?; }
    local cmd="$1"; shift
    case "${cmd}" in
        predict|p) cmd_predict "$@" ;;
        train|t) cmd_train "$@" ;;
        scan) cmd_scan "$@" ;;
        analyze|a) cmd_analyze "$@" ;;
        test) cmd_test "$@" ;;
        journal|j) cmd_journal "$@" ;;
        status|s) cmd_status ;;
        promote) cmd_promote ;;
        loop|l) cmd_loop ;;
        help|-h|--help) echo "buddy <predict|train|scan|analyze|test|journal|status|loop>" ;;
        *) cmd_predict "${cmd}" "$@" ;;
    esac
}

main "$@"
