#!/usr/bin/env bash
# BUDDY — Cyberpunk Command Bridge
# Usage: ./buddy [--live | --demo]
#
# All env-var setup lives in scripts/init.sh — single source of truth
# shared with src/bootstrap/env.py. Operators edit .env.local.toggles
# once; every restart inherits the same behavior.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# shellcheck source=scripts/init.sh
source "$SCRIPT_DIR/scripts/init.sh"

exec python -m src.tui "$@"
