#!/usr/bin/env bash
# BUDDY — Cyberpunk Command Bridge
# Usage: ./buddy [--live | --demo]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

# Load OANDA credentials from .env.local if present
if [ -f ".env.local" ]; then
    set -a
    source .env.local
    set +a
fi

# Activate venv if it exists
if [ -f ".venv/bin/activate" ]; then
    source .venv/bin/activate
fi

exec python -m src.tui.app "$@"
