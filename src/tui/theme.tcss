/* ═══════════════════════════════════════════════════════════════════
   BUDDY // 2046 COMMAND BRIDGE THEME
   Neon operations console meets Bloomberg-grade density
   ═══════════════════════════════════════════════════════════════════ */

/* ── Global ─────────────────────────────────────────────────────── */

Screen {
    background: #05060a;
    color: #e8f7ff;
}

/* ── Header Bar ─────────────────────────────────────────────────── */

#header-bar {
    dock: top;
    height: 3;
    background: #090b14;
    color: #00f5ff;
    padding: 0 1;
    border-bottom: double #ff2bd6;
}

#header-bar .title {
    color: #00f5ff;
    text-style: bold;
}

#header-bar .nav-value {
    color: #39ff14;
    text-style: bold;
}

#header-bar .nav-label {
    color: #7483b8;
}

/* ── Tab Bar ────────────────────────────────────────────────────── */

TabbedContent {
    height: 1fr;
}

Tabs {
    background: #080a12;
    dock: top;
    height: 3;
    border-bottom: solid #26304f;
}

Tab {
    background: #080a12;
    color: #7483b8;
    padding: 0 2;
    text-style: none;
}

Tab:hover {
    background: #101627;
    color: #00f5ff;
}

Tab.-active {
    background: #ff2bd6;
    color: #05060a;
    text-style: bold;
}

Tab.-active:hover {
    background: #ffea00;
    color: #05060a;
    text-style: bold;
}

Underline {
    color: #00f5ff;
}

TabPane {
    padding: 1;
}

/* ── Panels (generic containers) ────────────────────────────────── */

.panel {
    border: solid #26304f;
    background: #0b0f1a;
    padding: 0 1;
    margin: 0 0 1 0;
}

.panel:focus-within {
    border: tall #00f5ff;
}

/* Mythos audit 2026-05-04 — global focus highlight. Any widget with the
   `can_focus = True` flag (mouse-clickable into focus) gets a prominent
   magenta double-border so the operator knows EXACTLY which box is
   active before pressing 'c' to copy that box's content. Higher
   specificity than .panel:focus-within so it wins for direct focus. */
*:focus {
    border: double #ff2bd6;
}

.panel-title {
    color: #00f5ff;
    text-style: bold;
    background: #0b0f1a;
}

/* ── Brain Stream (RichLog) ─────────────────────────────────────── */

#brain-stream {
    border: double #b84dff;
    background: #070912;
    height: 1fr;
    min-height: 10;
}

#brain-stream:focus {
    border: tall #ff2bd6;
}

RichLog {
    background: #070912;
    color: #e8f7ff;
    scrollbar-color: #26304f;
    scrollbar-color-active: #ff2bd6;
    scrollbar-background: #05060a;
}

/* ── Live Trades Table ──────────────────────────────────────────── */

DataTable {
    background: #090d18;
    color: #e8f7ff;
    height: auto;
    max-height: 15;
}

DataTable > .datatable--header {
    background: #111827;
    color: #00f5ff;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #1f2a44;
    color: #ffea00;
}

DataTable > .datatable--hover {
    background: #101627;
}

/* ── Sparkline ──────────────────────────────────────────────────── */

Sparkline {
    min-height: 2;
}

/* ── Agent Bars ─────────────────────────────────────────────────── */

ProgressBar {
    padding: 0;
    margin: 0;
}

ProgressBar > .bar--bar {
    color: #00f5ff;
    background: #26304f;
}

ProgressBar > .bar--complete {
    color: #39ff14;
}

Bar {
    color: #00f5ff;
    background: #26304f;
}

/* ── Status Indicators ──────────────────────────────────────────── */

.status-ok {
    color: #39ff14;
    text-style: bold;
}

.status-warn {
    color: #ffb000;
    text-style: bold;
}

.status-error {
    color: #ff3158;
    text-style: bold;
}

.status-dim {
    color: #7483b8;
}

/* ── Profit/Loss Colors ─────────────────────────────────────────── */

.profit {
    color: #39ff14;
}

.loss {
    color: #ff3158;
}

.neutral {
    color: #7483b8;
}

/* ── Overview Layout ────────────────────────────────────────────── */

#overview-container {
    height: 1fr;
}

#overview-top {
    height: 55%;
    min-height: 15;
}

#overview-bottom {
    height: 45%;
    min-height: 12;
}

#overview-top > .panel,
#overview-bottom > .panel,
#overview-bottom > Vertical {
    width: 1fr;
}

/* MTF Confluence Panel */
#mtf-panel {
    border: double #b84dff;
    background: #0b0f1a;
    padding: 0 1;
}

#mtf-panel:focus-within {
    border: tall #ff2bd6;
}

.mtf-screen {
    width: 1fr;
    height: auto;
    padding: 0 1;
    border-right: solid #26304f;
}

.mtf-screen:last-child {
    border-right: none;
}

.mtf-label {
    color: #b84dff;
    text-style: bold;
    text-align: center;
}

.mtf-score {
    text-align: center;
}

#confluence-bar {
    height: 3;
    padding: 0 1;
}

/* ── Risk Panel ─────────────────────────────────────────────────── */

#risk-panel {
    border: double #ffb000;
    background: #11100a;
    padding: 0 1;
}

#risk-panel:focus-within {
    border: tall #ffb000;
}

/* ── System Health ──────────────────────────────────────────────── */

#system-health {
    dock: bottom;
    height: 3;
    background: #080a12;
    color: #7483b8;
    padding: 0 1;
    border-top: double #00f5ff;
}

/* ── Agent Consensus Panel ──────────────────────────────────────── */

.agent-row {
    height: 1;
    layout: horizontal;
}

.agent-name {
    width: 12;
    color: #7483b8;
}

.agent-score {
    width: 6;
    color: #00f5ff;
    text-style: bold;
}

.agent-signal {
    width: 10;
}

/* ── Scrollbar Styling ──────────────────────────────────────────── */

* {
    scrollbar-color: #26304f;
    scrollbar-color-active: #00f5ff;
    scrollbar-color-hover: #ff2bd6;
    scrollbar-background: #05060a;
    scrollbar-corner-color: #05060a;
}

/* ── Footer ─────────────────────────────────────────────────────── */

Footer {
    background: #080a12;
    color: #7483b8;
}

Footer > .footer--key {
    color: #00f5ff;
    background: #1f2a44;
}

Footer > .footer--description {
    color: #7483b8;
}

/* ── Placeholder Screens ────────────────────────────────────────── */

.placeholder-screen {
    align: center middle;
    color: #7483b8;
}

.placeholder-screen .coming-soon {
    color: #b84dff;
    text-style: bold italic;
    text-align: center;
}

/* ── Input / Command ────────────────────────────────────────────── */

Input {
    background: #090d18;
    color: #e8f7ff;
    border: solid #26304f;
}

Input:focus {
    border: tall #00f5ff;
}

/* ── Button ─────────────────────────────────────────────────────── */

Button {
    background: #111827;
    color: #00f5ff;
    border: solid #26304f;
}

Button:hover {
    background: #00f5ff;
    color: #05060a;
}

Button:focus {
    border: tall #ff2bd6;
}

/* ── Rule (divider) ─────────────────────────────────────────────── */

Rule {
    color: #26304f;
}

/* ── Loading ────────────────────────────────────────────────────── */

LoadingIndicator {
    color: #00f5ff;
}

/* ═══════════════════════════════════════════════════════════════════
   TRADES SCREEN -- The Trading Floor (F2)
   ═══════════════════════════════════════════════════════════════════ */

TradesScreen {
    height: 1fr;
}

#trades-open-panel {
    height: auto;
    max-height: 40%;
    min-height: 6;
}

#trades-drilldown {
    border: double #b84dff;
    background: #0b0f1a;
    height: auto;
    min-height: 3;
    max-height: 45%;
    margin: 0 0 1 0;
    padding: 0 1;
}

#trades-drilldown:focus {
    border: tall #ff2bd6;
}

#trades-closed-panel {
    height: auto;
    max-height: 35%;
    min-height: 6;
}

/* ═══════════════════════════════════════════════════════════════════
   AGENTS SCREEN -- The Agent Lab (F3)
   ═══════════════════════════════════════════════════════════════════ */

AgentsScreen {
    height: 1fr;
}

#agents-weight-panel {
    height: auto;
    max-height: 45%;
    min-height: 8;
}

#agents-middle-row {
    height: auto;
    max-height: 40%;
    min-height: 8;
}

#agents-middle-row > .panel {
    width: 1fr;
}

#agents-accuracy-panel {
    width: 1fr;
}

#agents-voting-panel {
    width: 1fr;
}

#agents-disagreement-panel {
    height: auto;
    max-height: 20%;
    min-height: 5;
}

/* ═══════════════════════════════════════════════════════════════════
   CONFIG SCREEN -- The Control Room (F5)
   ═══════════════════════════════════════════════════════════════════ */

ConfigScreen {
    height: 1fr;
}

#config-profile-panel {
    height: auto;
    max-height: 6;
    min-height: 4;
}

#config-profile-row {
    height: auto;
    padding: 0 1;
    align: left middle;
}

#config-profile-radios {
    width: auto;
    height: auto;
    layout: horizontal;
}

#config-profile-radios RadioButton {
    background: #090d18;
    color: #7483b8;
    height: auto;
    padding: 0 1;
}

#config-profile-radios RadioButton:hover {
    color: #00f5ff;
}

#btn-apply-profile {
    margin: 0 1;
    min-width: 16;
    background: #111827;
    color: #00f5ff;
}

#btn-apply-profile:hover {
    background: #00f5ff;
    color: #05060a;
}

#btn-save-config {
    margin: 0 1;
    min-width: 10;
    background: #111827;
    color: #39ff14;
}

#btn-save-config:hover {
    background: #39ff14;
    color: #05060a;
}

#btn-reset-config {
    margin: 0 1;
    min-width: 18;
    background: #111827;
    color: #ffb000;
}

#btn-reset-config:hover {
    background: #ffb000;
    color: #05060a;
}

#config-status-label {
    width: auto;
    margin: 0 1;
    color: #7483b8;
}

#config-middle-row {
    height: 1fr;
    min-height: 12;
}

#config-middle-row > .panel {
    width: 1fr;
}

#config-gates-panel {
    width: 1fr;
}

#config-agents-panel {
    width: 1fr;
}

#config-gates-scroll {
    height: 1fr;
    min-height: 8;
}

#config-agents-scroll {
    height: 1fr;
    min-height: 8;
}

/* Gate section headers */
#gate-section-conf,
#gate-section-uncert,
#gate-section-risk,
#gate-section-trade,
#gate-section-filter {
    color: #b84dff;
    text-style: bold;
    padding: 1 0 0 0;
}

/* Config field rows */
.config-field-row {
    height: 3;
    align: left middle;
    padding: 0 1;
}

.config-field-label {
    width: 20;
    color: #7483b8;
}

.config-field-input {
    width: 16;
    height: 3;
    background: #090d18;
    color: #00f5ff;
    border: solid #26304f;
}

.config-field-input:focus {
    border: tall #00f5ff;
}

/* Agent toggle rows */
.config-toggle-row {
    height: 3;
    align: left middle;
    padding: 0 1;
}

.config-toggle-label {
    width: 18;
    color: #7483b8;
}

.config-toggle-switch {
    width: auto;
}

Switch {
    background: #26304f;
}

Switch.-on > .switch--slider {
    color: #39ff14;
}

Switch.-off > .switch--slider {
    color: #ff3158;
}

#config-history-panel {
    height: auto;
    max-height: 30%;
    min-height: 6;
}

/* ═══════════════════════════════════════════════════════════════════
   DIAGNOSTICS SCREEN -- The Engine Room (F6)
   ═══════════════════════════════════════════════════════════════════ */

DiagnosticsScreen {
    height: 1fr;
}

#diag-row-0 {
    height: auto;
    max-height: 38%;
    min-height: 10;
}

#diag-row-0 > .panel {
    width: 1fr;
}

#diag-vitals-panel {
    width: 1fr;
}

#diag-oanda-panel {
    width: 1fr;
}

#diag-test-btn {
    margin: 0 1;
    width: auto;
    min-width: 20;
    background: #111827;
    color: #00f5ff;
}

#diag-test-btn:hover {
    background: #00f5ff;
    color: #05060a;
}

#diag-row-1 {
    height: auto;
    max-height: 38%;
    min-height: 8;
}

#diag-row-1 > .panel {
    width: 1fr;
}

#diag-models-panel {
    width: 1fr;
}

#diag-errors-panel {
    width: 1fr;
}

#diag-error-header {
    height: auto;
    max-height: 3;
}

#diag-error-header .panel-title {
    width: 1fr;
}

#diag-severity-filter {
    width: 12;
    height: 3;
    margin: 0 1;
    background: #090d18;
    color: #00f5ff;
    border: solid #26304f;
}

#diag-error-log {
    border: double #b84dff;
    background: #070912;
    height: 1fr;
    min-height: 5;
}

#diag-error-log:focus {
    border: tall #ff2bd6;
}

#diag-maint-panel {
    height: auto;
    max-height: 25%;
    min-height: 6;
}

/* ── StateStrip (Supervisor State Bar — US-504) ─────────────────── */

#state-strip {
    height: 1;
    background: #090b14;
    padding: 0 1;
    border-bottom: solid #26304f;
}

.state-running {
    color: #39ff14;
    text-style: bold;
}

.state-paused {
    color: #ffb000;
    text-style: bold;
}

.state-halted {
    color: #ff3158;
    text-style: bold;
}

.mode-dryrun {
    color: #00f5ff;
    text-style: bold;
}

.mode-live {
    color: #ff3158;
    text-style: bold;
}

/* ═══════════════════════════════════════════════════════════════════
   GATE TRACE MODAL — US-512  (PASS / NEAR-MISS / FAIL color-coding)
   ═══════════════════════════════════════════════════════════════════ */

GateTraceModal {
    align: center middle;
}

GateTraceModal #trace-dialog {
    border: double #00f5ff;
    background: #05060a;
}

GateTraceModal #trace-title {
    color: #00f5ff;
    text-style: bold;
}

GateTraceModal .trace-section {
    background: #0b0f1a;
    border: solid #26304f;
}

.gate-pass {
    color: #39ff14;
    text-style: bold;
}

.gate-near {
    color: #ffb000;
    text-style: bold;
}

.gate-fail {
    color: #ff3158;
    text-style: bold;
}
