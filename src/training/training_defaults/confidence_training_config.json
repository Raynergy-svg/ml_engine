{
  "schema_version": 1,
  "head": "confidence",
  "model_class": "lightgbm",
  "description": "LightGBM confidence head (Ridge fallback). Mirrors the 2026-04-30 leak-fix scripts. Operator-tunable label and HP knobs only; LightGBM internals (num_leaves, reg_alpha, reg_lambda, etc.) stay defaulted.",
  "label_generation": {
    "lookahead_bars": 12,
    "sl_atr_mult": 1.0,
    "tp_atr_mult": 1.5,
    "label_mode": "real",
    "winsorize_bounds": [-0.02, 0.02]
  },
  "training_behavior": {
    "enable_per_pair_finetune": true,
    "enable_joint_training": true,
    "min_real_labels_per_pair": 50,
    "expected_r2_band": [0.05, 0.30]
  },
  "hyperparameters": {
    "n_estimators": 100,
    "learning_rate": 0.1,
    "max_depth": 6
  },
  "ranges": {
    "lookahead_bars": [4, 48],
    "sl_atr_mult": [0.5, 3.0],
    "tp_atr_mult": [0.8, 4.0],
    "label_mode": ["real", "pseudo", "blend"],
    "n_estimators": [20, 1000],
    "learning_rate": [0.01, 0.5],
    "max_depth": [2, 12],
    "min_real_labels_per_pair": [20, 5000]
  }
}
