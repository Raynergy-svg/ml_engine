# Environment Configuration
ENV=development
DEBUG=true

# --- OANDA PRACTICE (FX Tier-1) ---
# Copy this file to `.env` and fill values locally.
# Never commit `.env` (it is already in `.gitignore`).
# Prefer setting these in Colab via Secrets (key icon) instead of editing the notebook.

# OANDA API token (practice)
OANDA_API_TOKEN=
# Alternatively, if you use this name in your environment:
# OANDA_API_KEY=

# OANDA practice account id
OANDA_ACCOUNT_ID=

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Logging
LOG_LEVEL=INFO

# Security (set in production)
# API_KEY=your-secret-api-key-here

# Database (optional)
# DATABASE_URL=postgresql://user:pass@localhost/mlengine
