# Buddy behavior toggles — copy to .env.local.toggles and edit.
#
# This file is sourced by ./buddy via scripts/init.sh AND by Python via
# src/bootstrap/env.py. Either entry point sees identical values.
#
# Class-C toggles the operator currently must remember to export by
# hand. Pinning them here means they survive every restart.

# ───────────────────────────────────────────────────────────────────────
# Hot-reload + safe-restart — see scripts/init.sh, Phase 1 just adds
# the env-init layer; Phase 2 will land the file watcher.
# ───────────────────────────────────────────────────────────────────────
# BUDDY_HOT_RELOAD=0          # 0 = disabled (Phase 1 default), 1 = enable watcher (Phase 2+)

# ───────────────────────────────────────────────────────────────────────
# Meta-cybernetic pipeline routing
# ───────────────────────────────────────────────────────────────────────
# BUDDY_META_MANAGER_ENABLED=1  # Route post-trade incidents into MetaManager
# BUDDY_META_USE_LLM=0          # 0 = no Claude calls in autonomy plane,
                                # 1 = allow Claude reflection (legacy)

# ───────────────────────────────────────────────────────────────────────
# Model freshness thresholds (days)
# ───────────────────────────────────────────────────────────────────────
# BUDDY_FRESHNESS_AGING_DAYS=3
# BUDDY_FRESHNESS_STALE_DAYS=5
# BUDDY_FRESHNESS_CRITICAL_DAYS=7

# ───────────────────────────────────────────────────────────────────────
# Training / autonomous-retrain
# ───────────────────────────────────────────────────────────────────────
# BUDDY_TRAIN_DAYS=21
# BUDDY_DISABLE_AUTOTRAIN_ON_STALE=0

# ───────────────────────────────────────────────────────────────────────
# Telemetry tags (optional)
# ───────────────────────────────────────────────────────────────────────
# BUDDY_SESSION_ID=             # auto-generated per process if unset
# BUDDY_WANDB_PROJECT=
# BUDDY_WANDB_ENTITY=

# ───────────────────────────────────────────────────────────────────────
# Debug
# ───────────────────────────────────────────────────────────────────────
# BUDDY_DEBUG=1                 # Skip TUI's stderr redirect — tracebacks on terminal
